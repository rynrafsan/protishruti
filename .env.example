# Copy to .env and fill in. NEVER commit .env.
# AI provider: groq (default, free, no card) | mock (offline, no AI) | gemini | anthropic
LLM_PROVIDER=groq
# Groq key from https://console.groq.com/keys ; vision models: https://console.groq.com/docs/vision
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_S=90
LLM_MAX_TOKENS=800           # Groq free tier allows 1000 output tokens per minute
# Optional: also use the AI to read transcripts / write the Bangla explanation
# (default: off on Groq to save the free quota; on for Gemini/Claude)
LLM_EXTRACT=
LLM_EXPLAIN=
# Rights Q&A: true = AI writes a cited answer from the retrieved passages; false = best sentences word for word
RAG_GENERATE=true

# Optional other providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

ASR_ENABLED=false            # true = accept voice notes
ASR_BACKEND=groq             # groq (free API, Whisper large-v3) | local (Bengali.AI model, big install)
ASR_GROQ_MODEL=whisper-large-v3
ASR_MODEL=bengaliAI/tugstugi_bengaliai-regional-asr_whisper-medium

AGENCY_CSV=data/agencies_sample.csv
RECORDS_DIR=records
ALLOW_REAL_DATA=false        # keep false until legal review + local ID masking are done

# WhatsApp (Phase 2)
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v22.0
PUBLIC_BASE_URL=
WA_DISPLAY_NUMBER=           # shown on the website, e.g. 8801XXXXXXXXX; empty = "pilot" notice

# Live /docs (pitch deck + technical docs). Admin panel at /docs/admin. Passwords: 12+ characters, never commit them.
DOCS_ADMIN_PASSWORD=
DOCS_SUPERADMIN_PASSWORD=
DOCS_SECRET=                 # any long random text; keeps admins signed in across restarts
DOCS_PUBLIC=true             # false = /docs shows "not available" (403) to visitors
DOCS_SCHEDULE=true
DOCS_OPEN_FROM=2026-11-20T00:00   # Bangladesh time (GMT+6)
DOCS_OPEN_UNTIL=2026-12-31T23:59
# Optional: publishing commits data/docs/content.json to GitHub, so edits survive Render restarts
DOCS_GITHUB_REPO=            # e.g. rynrafsan/protishruti
DOCS_GITHUB_TOKEN=           # fine-grained token, this repo only, Contents: read and write
